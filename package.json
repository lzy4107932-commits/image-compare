{
  "name": "image-compare",
  "private": true,
  "version": "1.2.0",
  "main": "electron/main.cjs",
  "type": "module",
  "scripts": {
    "dev": "concurrently -k \"vite --host 127.0.0.1\" \"wait-on http://127.0.0.1:5173 && electron .\"",
    "build": "tsc -b && vite build",
    "lint": "oxlint .",
    "test": "vitest run",
    "test:watch": "vitest",
    "check": "npm run lint && npm run test && npm run build",
    "check:all": "npm run check && npm run smoke:electron",
    "smoke:electron": "node scripts/electron-smoke.cjs",
    "smoke:packaged": "node scripts/electron-smoke.cjs --packaged",
    "preview": "vite preview",
    "icons": "node src/generate-icons.mjs",
    "electron:build": "npm run electron:build:win",
    "electron:build:win": "npm run build && npm run icons && electron-builder --win nsis --x64",
    "electron:build:mac": "npm run build && npm run icons && electron-builder --mac dmg zip --arm64 --publish never"
  },
  "dependencies": {
    "lucide-react": "^1.34.0",
    "react": "^19.2.8",
    "react-dom": "^19.2.8"
  },
  "devDependencies": {
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.7",
    "@types/node": "^24.13.3",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.4",
    "@vitejs/plugin-react": "^6.1.0",
    "concurrently": "^10.0.5",
    "electron": "^44.0.0",
    "electron-builder": "^26.15.3",
    "jsdom": "^30.0.1",
    "oxlint": "^1.79.0",
    "png-to-ico": "^3.0.2",
    "sharp": "^0.35.4",
    "typescript": "~6.0.2",
    "vite": "^8.2.2",
    "vitest": "5.0.0",
    "wait-on": "^9.1.0"
  },
  "allowScripts": {
    "electron-winstaller@5.4.0": true
  },
  "description": "图片对比工具",
  "author": "信",
  "build": {
    "appId": "com.imagecompare.app",
    "productName": "图片对比工具",
    "directories": {
      "output": "release"
    },
    "files": [
      "dist-renderer/**/*",
      "electron/**/*",
      "package.json"
    ],
    "win": {
      "icon": "build/icon.ico",
      "target": "nsis",
      "artifactName": "Image-Compare-${version}-Windows-${arch}-Setup.${ext}"
    },
    "mac": {
      "icon": "build/icon.icns",
      "category": "public.app-category.photography",
      "identity": "-",
      "hardenedRuntime": false,
      "notarize": false,
      "artifactName": "Image-Compare-${version}-macOS-${arch}.${ext}",
      "target": [
        {
          "target": "dmg",
          "arch": [
            "arm64"
          ]
        },
        {
          "target": "zip",
          "arch": [
            "arm64"
          ]
        }
      ]
    },
    "dmg": {
      "title": "图片对比工具 ${version}",
      "icon": "build/icon.icns",
      "backgroundColor": "#181818",
      "window": {
        "width": 540,
        "height": 440
      },
      "contents": [
        {
          "x": 140,
          "y": 190,
          "type": "file"
        },
        {
          "x": 400,
          "y": 190,
          "type": "link",
          "path": "/Applications"
        },
        {
          "x": 270,
          "y": 340,
          "type": "file",
          "path": "MACOS_INSTALL.txt"
        }
      ]
    },
    "nsis": {
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true
    }
  }
}
